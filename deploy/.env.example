# Copie para .env e preencha. NUNCA versione o .env real (já está no .gitignore).

# Domínio que aponta para o IP público do VPS (sem http://). Ex.: DuckDNS.
DOMAIN=SEU_SUBDOMINIO.duckdns.org

# Segredo dos tokens JWT. Gere um valor aleatório longo, por exemplo:
#   openssl rand -base64 48
REMOTEONE_JWT_SECRET=troque-por-um-segredo-aleatorio-longo

# Senha do banco Postgres (troque por uma forte).
POSTGRES_PASSWORD=troque-esta-senha
