# Copie para .env e preencha. NUNCA versione o .env real (já está no .gitignore).

# Domínio que aponta para o IP público do VPS (sem http://). Ex.: DuckDNS.
DOMAIN=SEU_SUBDOMINIO.duckdns.org

# Segredo dos tokens JWT. Gere um valor aleatório longo, por exemplo:
#   openssl rand -base64 48
DESKSIDE_JWT_SECRET=troque-por-um-segredo-aleatorio-longo

# Senha do banco Postgres (troque por uma forte).
POSTGRES_PASSWORD=troque-esta-senha

# Segredo do TURN (relay de vídeo). O backend gera as credenciais temporárias
# com ele e o coturn as confere - os dois PRECISAM ter o mesmo valor, senão o
# relay recusa todo mundo e a falha aparece só como "não conectou".
# Gere com: openssl rand -base64 48
DESKSIDE_TURN_SECRET=troque-este-segredo

# IP público do VPS (o reservado, do passo 3 do guia da Oracle). O TURN precisa
# ANUNCIAR este endereço: a VM só enxerga o IP privado, e anunciar o privado
# faz o relay virar um endereço que ninguém alcança. Deixe vazio para o coturn
# tentar descobrir sozinho.
TURN_EXTERNAL_IP=

# IP PRIVADO da VM (o que aparece em `ip -4 addr show`, tipo 10.0.0.182). É a
# placa por onde os pacotes chegam de verdade; sem apontá-la, o coturn escuta
# também nas pontes internas do Docker e pode alocar o relay num endereço
# inalcançável de fora.
TURN_LISTEN_IP=10.0.0.182
